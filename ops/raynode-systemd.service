[Unit]
Description=Elegant Developer Studio Next.js standalone runtime
After=network.target

[Service]
Type=simple
User=ray
WorkingDirectory=/srv/apps/elegant-developer-studio-runtime
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3001
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
