{
  "name": "elegant-developer-studio",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "release:evidence": "node scripts/write-release-evidence.mjs",
    "validate:release-evidence": "node scripts/validate-release-evidence.mjs",
    "validate:content": "node scripts/validate-content-relations.mjs",
    "report:command-index": "node scripts/report-command-index.mjs",
